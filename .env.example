# Server
PORT=3000
NODE_ENV=development

# .NET bridge (node-api-dotnet)
# Absolute path to the compiled .NET business-layer DLL.
DOTNET_DLL_PATH=C:/Users/QIS-ITS/Documents/githubs/Medinfras_v2.2/QIS.Medinfras.Web.CommonLibs/bin/QIS.Medinfras.Data.Service.dll

# .NET runtime target that node-api-dotnet should load (must match the DLL's target framework).
# Examples: net472, net6.0, net8.0
DOTNET_RUNTIME=net472
